{
  "name": "@dash/server",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:better-sqlite3 --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "skills:scan": "tsx scripts/scanSkills.ts"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.4.6",
    "@anthropic-ai/sdk": "0.125.0",
    "@dash/shared": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
