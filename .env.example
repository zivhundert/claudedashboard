# ============================================================================
# Claude Code Insights — server configuration
# Copy to .env at the repo root:  cp .env.example .env
# Relative paths resolve against the repo root (not the current directory).
#
# The dashboard wears one of two hats (see README "Two ways to run it"):
#   Hat 1  TELEMETRY mode — any team, no special account. Claude Code's own
#          OpenTelemetry exporter pushes usage to this server.
#   Hat 2  API mode — orgs with a Console Admin key or a claude.ai Enterprise
#          Analytics key; the server pulls org-wide data on a schedule.
# The mode is auto-detected from which keys are set below, or pinned with
# DATA_SOURCE. Uncomment exactly one recipe to start.
# ============================================================================

# ----------------------------------------------------------------------------
# RECIPE 1 — Telemetry mode (Hat 1, default): no Anthropic org-API access
# needed. Works for Pro/Max/Team seats and for Claude Code on Bedrock/Vertex.
# After booting, roll the client snippet out to dev machines:
# docs/telemetry-setup.md
# ----------------------------------------------------------------------------
# DATA_SOURCE=telemetry
# DB_PATH=./data/telemetry.db
# PRIVACY_MODE=balanced
# OTEL_INGEST_TOKEN=            # recommended: openssl rand -hex 32
# ORG_TIMEZONE=Asia/Jerusalem   # IANA zone the daily buckets are keyed by
# OTEL_MAX_BODY_MB=8            # raise if otel_batch_too_large climbs

# ----------------------------------------------------------------------------
# RECIPE 2a — Console mode (Hat 2): org billed via the Anthropic API/Console.
# Key: Claude Console -> Settings -> Admin keys (org admin), sk-ant-admin...
# Unlocks: roster + seats, invoice-grade costs, API-key inventory, service-tier
# and context-window mixes, full historical backfill.
# ----------------------------------------------------------------------------
# ADMIN_API_KEY=sk-ant-admin...
# DB_PATH=./data/console.db

# ----------------------------------------------------------------------------
# RECIPE 2b — Enterprise mode (Hat 2): claude.ai Team/Enterprise seats.
# Key: claude.ai -> Organization settings -> API (org's PRIMARY OWNER only).
# Unlocks: seats + billed spend; history from 2026-01-01; engagement data
# lags 1-3 days (handled automatically).
# ----------------------------------------------------------------------------
# ENTERPRISE_ANALYTICS_KEY=...
# DB_PATH=./data/enterprise.db

# ----------------------------------------------------------------------------
# RECIPE 3 — Demo mode: seeded synthetic org, no keys, no outbound API calls.
# Usually run via `pnpm seed && pnpm run dev:demo` instead of this file.
# ----------------------------------------------------------------------------
# DEMO_MODE=1
# DB_PATH=./data/dashboard.db

# ============================================================================
# Everything below applies to any mode (defaults shown).
# ============================================================================

# --- Mode pinning -------------------------------------------------------------
# Auto-detection order: DEMO_MODE=1 -> demo; ENTERPRISE_ANALYTICS_KEY ->
# enterprise; ADMIN_API_KEY -> console; no key at all -> telemetry.
# Set DATA_SOURCE (demo | telemetry | console | enterprise) to override —
# e.g. keep keys configured but run a pure-OTel dashboard.
# IMPORTANT: pair each mode with its own DB_PATH. Core usage tables are
# single-writer per mode; switching modes on one database file would mix
# API-written and telemetry-written history.
DATA_SOURCE=

# --- Runtime -----------------------------------------------------------------
# HTTP port for the API, the OTLP ingest endpoints, and (in production) the
# built web app. Dev machines' OTEL_EXPORTER_OTLP_ENDPOINT points here.
PORT=8080

# Optional: run the OTLP receiver (POST /otel/v1/*) on its own port instead of
# PORT, so dev machines can reach the receiver while the dashboard stays on an
# internal-only port. When set, /otel/* is NOT served on PORT any more and
# OTEL_EXPORTER_OTLP_ENDPOINT must point at this port. Leave empty to share PORT.
OTEL_PORT=

# SQLite database location. The parent directory is created automatically.
DB_PATH=./data/dashboard.db

# Where the built SPA lives in production (`pnpm build` output).
# Only used by `pnpm start` / Docker — the dev server serves the SPA itself.
WEB_DIST_PATH=web/dist

# --- Telemetry ingest (active in every mode; primary source in Hat 1) ---------
# The server accepts Claude Code OpenTelemetry pushes at POST /otel/v1/logs
# and POST /otel/v1/metrics. In telemetry mode this feeds the whole dashboard;
# in console/enterprise mode it adds the Skills/Activity/Health packs on top.
#
# Privacy filter applied to every record BEFORE storage (docs/telemetry-setup.md):
#   minimal  — counts/outcomes only; skill/MCP/plugin names bucketed
#   balanced — names + counts/models/tokens/cost; commands, file paths,
#              arguments and prompt text dropped (default)
#   full     — everything the exporter sends (locked-down servers only)
PRIVACY_MODE=balanced

# Optional shared secret: when set, incoming telemetry must send
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>.
# Leave empty only on trusted internal networks.
OTEL_INGEST_TOKEN=

# --- Sync schedule (Hat 2 pulls; in Hat 1 only nightly housekeeping runs) ------
# Nightly full sync (roster -> recent daily usage -> hourly -> costs/keys/
# dimensions -> score snapshot), cron expression evaluated in SYNC_TZ.
# Pick an early-morning hour in your timezone — after the UTC day closes
# plus the API's ~1h data lag. Set SYNC_TZ to your IANA timezone.
SYNC_CRON=0 5 * * *
SYNC_TZ=Asia/Jerusalem

# Refresh the current (partial) UTC day + hourly tail every N minutes.
# 0 disables intraday refresh; the nightly sync still runs.
INTRADAY_SYNC_MINUTES=60

# --- Historical backfill (Hat 2 only; runs once on first boot, resumable) ------
# Walk backwards from today until this date (YYYY-MM-DD).
# Leave empty to auto-probe: stop after BACKFILL_EMPTY_STREAK consecutive
# days with zero records (hard cap 400 days back).
BACKFILL_START=
BACKFILL_EMPTY_STREAK=14

# Days of hourly (time-of-day heatmap) history to backfill. Heatmaps don't
# need a year; daily data covers long-range trends.
HOURLY_BACKFILL_DAYS=30

# --- Keys (see the recipes above for how to create each; never commit values) --
ADMIN_API_KEY=
ENTERPRISE_ANALYTICS_KEY=
DEMO_MODE=0

# --- Test-only overrides (leave unset in production) ---------------------------
# ENTERPRISE_API_BASE=http://localhost:8899   # point at server/scripts/mock-enterprise-api.ts
# ENTERPRISE_PACE_MS=1100                     # min gap between requests (org-wide 60/min)
